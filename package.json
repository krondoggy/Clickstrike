    "test:motion": "node games/castlestrike/tests/animation-browser.mjs",
    "test:combat": "node games/castlestrike/tests/combat-browser.mjs",
    "test:balance": "node games/castlestrike/tests/balance-report.mjs",
    "test:performance": "node games/castlestrike/tests/performance-browser.mjs",
